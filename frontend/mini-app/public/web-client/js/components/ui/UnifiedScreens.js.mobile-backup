            try {
                let response;
                let boats = [];
                
                if (type === 'quick' && params.lat && params.lon) {
                    response = await AquaGid.APIClient.getNearbyBoats(params.lat, params.lon);
                } else if (type === 'filtered') {
                    response = await AquaGid.APIClient.getAvailableBoats(
                        params.date, 
                        params.time, 
                        params.duration
                    );
                } else {
                    response = await AquaGid.APIClient.getAllBoats();
                }
                
                console.log('API response:', response);
                
                // Извлекаем массив катеров из ответа
                if (response && response.boats && Array.isArray(response.boats)) {
                    boats = response.boats;
                } else if (Array.isArray(response)) {
                    boats = response;
                } else {
                    console.error('Неожиданный формат ответа:', response);
                    return [];
                }
                
                // Преобразуем данные из API в формат наших компонентов
                let formattedBoats = boats.map(boat => ({
                    id: boat.id,
                    name: boat.name,
                    owner: boat.owner_name || 'Владелец',
                    description: boat.description || 'Описание отсутствует',
                    price: boat.price_per_hour,
                    capacity: boat.capacity,
                    rating: boat.rating || 4.5,
                    bookings_count: boat.bookings_count || 0,
                    has_subscription: boat.has_subscription || false,
                    is_new: this.isNewBoat(boat.created_at),
                    coordinates: boat.coordinates ? {
                        lat: parseFloat(boat.coordinates.split(',')[0]),
                        lon: parseFloat(boat.coordinates.split(',')[1])
                    } : null,
                    image: boat.images?.[0] || this.getPlaceholderImage(boat.name)
                }));
                
                // ПРИМЕНЯЕМ УМНУЮ СОРТИРОВКУ
                formattedBoats = this.sortBoats(formattedBoats, { type });
                
                return formattedBoats;
                
            } catch (error) {
                console.error('Ошибка загрузки катеров:', error);
                this.error = error.message;
                return [];
            } finally {
                this.loading = false;
            }
        }

        /**
         * Умная сортировка катеров (безопасная версия)
         */
        sortBoats(boats, options = {}) {
            if (!boats || !boats.length) return boats;
            
            try {
                const newArray = [...boats];
                
                // Безопасные веса (позже будут загружаться из админки)
                const weights = {
                    subscription: 100,
                    rating: 10,
                    popularity: 5,
                    newBoat: 3,
                    random: 1
                };
                
                // Вычисляем приоритет для каждого катера
                newArray.forEach(boat => {
                    let priority = 0;
                    
                    // 1. Подписка (самый высокий приоритет)
                    if (boat.has_subscription === true) {
                        priority += weights.subscription;
                    }
                    
                    // 2. Рейтинг (от 1 до 5)
                    if (boat.rating && typeof boat.rating === 'number') {
                        priority += Math.min(boat.rating, 5) * weights.rating;
                    }
                    
                    // 3. Популярность (количество бронирований)
                    if (boat.bookings_count && typeof boat.bookings_count === 'number') {
                        priority += Math.min(boat.bookings_count, 10) * weights.popularity;
                    }
                    
                    // 4. Новый катер
                    if (boat.is_new === true) {
                        priority += weights.newBoat;
                    }
                    
                    // 5. Случайность (чтобы не было застоя)
                    priority += Math.random() * weights.random;
                    
                    boat._priority = priority;
                });
                
                // Сортируем по приоритету (от большего к меньшему)
                newArray.sort((a, b) => (b._priority || 0) - (a._priority || 0));
                
                // Удаляем временное поле _priority
                newArray.forEach(boat => delete boat._priority);
                
                return newArray;
                
            } catch (error) {
                console.warn('Ошибка сортировки, возвращаем исходный массив:', error);
                return boats;
            }
        }

        /**
         * Проверка, новый ли катер (менее 30 дней)
         */
        isNewBoat(createdAt) {
            if (!createdAt) return false;
            
            try {
                const created = new Date(createdAt);
                const now = new Date();
                const diffDays = Math.floor((now - created) / (1000 * 60 * 60 * 24));
                return diffDays < 30; // 30 дней можно будет менять в админке
            } catch (e) {
                return false;
            }
        }

