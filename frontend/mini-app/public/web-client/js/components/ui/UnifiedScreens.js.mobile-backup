        /**
         * Выбрать кастомную продолжительность
         */
        selectCustomDuration() {
            const hours = parseInt(document.getElementById('custom-hours').value);
            const minutes = parseInt(document.getElementById('custom-minutes').value);
            
            const duration = hours + (minutes / 60);
            
            // Проверка на максимальную длительность (6 часов)
            if (duration > 6) {
                alert('Максимальная продолжительность - 6 часов');
                return;
            }
            
            console.log(`Выбрана продолжительность: ${duration} часов`);
            this.selectDuration(duration);
        }
        
