        /**
         * Форматирование продолжительности
         */
        formatDuration(hours) {
            if (!hours) return '';
            
            // Проверяем, целое ли число
            if (Number.isInteger(hours)) {
                return `${hours} ${this.getHoursWord(hours)}`;
            }
            
            // Для половинок (1.5, 2.5 и т.д.)
            const wholeHours = Math.floor(hours);
            if (hours === wholeHours + 0.5) {
                return `${wholeHours}.5 ${this.getHoursWord(hours)}`;
            }
            
            // Для других нецелых значений (если вдруг)
            return `${hours} ${this.getHoursWord(hours)}`;
        }

        getHoursWord(hours) {
            if (hours === 1) return 'час';
            if (hours === 1.5) return 'часа';
            if (hours > 1 && hours < 2) return 'часа';
            if (hours >= 2 && hours <= 4) return 'часа';
            return 'часов';
        }
        
