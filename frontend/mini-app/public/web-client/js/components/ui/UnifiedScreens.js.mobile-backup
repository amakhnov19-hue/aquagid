                    <h2>${message}</h2>
                    <p>${error.message || 'Попробуйте позже'}</p>
                    <button class="button" onclick="AquaGid.UnifiedScreens.startOver()">
                        В начало
                    </button>
                </div>
            `;
            this.render(html);
        }
        
        /**
         * Карточка катера
         */
        renderBoatCard(boat, type) {
            // Для теста генерируем расстояние
            const distance = (Math.random() * 1.5 + 0.5).toFixed(1);
            const walkTime = Math.ceil(distance * 12);
            
            // Если есть выбор времени - показываем кнопки
            const timeSelectionHTML = type === 'quick' && boat.hasTimeChoice && boat.secondarySlot
                ? `<div class="boat-card__time-choice">
                    <div class="time-choice-label">🕐 Выберите время начала:</div>
                    <div class="time-choice-buttons">
                    <button class="time-choice-btn primary" onclick="event.stopPropagation(); AquaGid.UnifiedScreens.selectBoatWithTime(${boat.id}, '${boat.availableFrom}')">
                        ${boat.availableFrom} ${boat.diffMinutes <= 5 ? '⚡' : ''}
                        <span class="time-choice-hint">${boat.diffMinutes <= 5 ? 'впритык' : 'успеваете'}</span>
                    </button>
                    <button class="time-choice-btn secondary" onclick="event.stopPropagation(); AquaGid.UnifiedScreens.selectBoatWithTime(${boat.id}, '${boat.secondarySlot}')">
                        ${boat.secondarySlot} (спокойно)
                        <span class="time-choice-hint">+30 мин</span>
                    </button>
                    </div>
                </div>`
                : type === 'quick' && boat.availableFrom
                ? `<div class="boat-card__available">
                    🕐 Свободен с ${boat.availableFrom}
                    <span class="boat-card__available-note">(можно начать в это время)</span>
                    <button class="boat-card__time-select" onclick="event.stopPropagation(); AquaGid.UnifiedScreens.selectBoatWithTime(${boat.id}, '${boat.availableFrom}')">
                    Выбрать это время
                    </button>
                </div>`
                : '';
            
            const distanceText = type === 'quick'
                ? `<div class="boat-card__distance">
                    🚶‍♂️ ${distance} км от вас (${walkTime} мин пешком)
                </div>`
                : '';
            
            return `
                <div class="boat-card" onclick="AquaGid.UnifiedScreens.selectBoat(${boat.id})">
                    <img src="${boat.image}" alt="${boat.name}" class="boat-card__image">
                    <div class="boat-card__content">
                        <h3 class="boat-card__title">${boat.name}</h3>
                        <div class="boat-card__owner">${boat.owner}</div>
                        <p class="boat-card__description">${boat.description}</p>
                        ${timeSelectionHTML}
                        ${distanceText}
                        <div class="boat-card__footer">
                            <span class="boat-card__price">${boat.price} ₽/час</span>
                            <div>
                                <button class="boat-card__button boat-card__button--details" onclick="event.stopPropagation(); AquaGid.UnifiedScreens.showBoatDetails(${boat.id})">
                                    Подробнее
                                </button>
                                <button class="boat-card__button" 
                                        onclick="event.stopPropagation(); 
                                                console.log('Клик по кнопке Выбрать для катера', ${boat.id});
                                                AquaGid.UnifiedScreens.selectBoat(${boat.id})">
                                    Выбрать
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        /**
         * Карточка даты
         */
        renderDateCard(date) {
            const dayNames = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
            const monthNames = ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
            
            const isSelected = this.booking.date && 
                new Date(this.booking.date).toDateString() === date.toDateString();
            
            return `
                <div class="date-card ${isSelected ? 'selected' : ''}" onclick="AquaGid.UnifiedScreens.selectDate('${date.toISOString()}')">
                    <div class="date-card__day">${dayNames[date.getDay()]}</div>
                    <div class="date-card__number">${date.getDate()}</div>
                    <div class="date-card__month">${monthNames[date.getMonth()]}</div>
                </div>
            `;
        }

        /**
         * Карточка времени
         */
        renderTimeCard(time) {
            const isSelected = this.booking.time === time;
            const isAvailable = true; // TODO: проверить через API
            
            return `
                <div class="time-card ${isSelected ? 'selected' : ''} ${!isAvailable ? 'disabled' : ''}" 
                    onclick="${isAvailable ? `AquaGid.UnifiedScreens.selectTime('${time}')` : ''}">
                    ${time}
                </div>
            `;
        }
        
