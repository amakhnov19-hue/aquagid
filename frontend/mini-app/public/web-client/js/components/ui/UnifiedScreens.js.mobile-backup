(function(global) {
    'use strict';
    
    const VERSION = '20260224_01';
    
    // Режимы работы
    const MODES = {
        QUICK: 'quick',        // ⚡ Ближайший катер
        FROM_BOAT: 'fromBoat', // 🚤 От катера
        FROM_DATE: 'fromDate'  // 📅 От даты
    };
    
    // Типы экранов
    const SCREENS = {
        WELCOME: 'welcome',           // Приветствие (старт)
        BOAT_SELECTION: 'boat-selection', // Выбор катера
        DATE: 'date',                 // Выбор даты
        TIME: 'time',                 // Выбор времени
        DURATION: 'duration',          // Выбор продолжительности
        CONFIRMATION: 'confirmation',  // Подтверждение
        SUCCESS: 'success'             // Успех
    };
    
    class UnifiedScreens {
        constructor() {
            this.version = VERSION;
            this.currentScreen = SCREENS.WELCOME;
            this.currentMode = MODES.QUICK;
            
            // Состояние бронирования
            this.booking = {
                boat: null,
                date: null,
                time: null,
                duration: null,
                client: {
                    name: '',
                    phone: '',
                    email: ''
                },
                price: {
                    total: 0,
                    prepayment: 0,
                    remaining: 0
                }
            };
            
            // Временные данные для экранов
            this.temp = {
                availableBoats: [],
                availableDates: [],
                availableTimes: [],
                availableDurations: [1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6], // часы
                userLocation: null,
                quickBoats: [] // для ветки ближайший катер
            };

            // 👇 НОВЫЕ СВОЙСТВА ВСТАВЛЯЕМ СЮДА
            this.loading = false;
            this.error = null;
            // 👆 ДОБАВИЛИ
            
            // Коллбек для синхронизации с BookingStorage
            this.onBookingChange = null;

            // Проверяем наличие TimeService
            if (!global.AquaGid?.TimeService) {
                console.warn('⚠️ TimeService not loaded, using fallback');
            } else {
                console.log('✅ TimeService loaded');
            }
            
            // Проверяем наличие SupportChat и Documentation
            if (!global.AquaGid?.SupportChat) {
                console.warn('⚠️ SupportChat not loaded');
            }
            if (!global.AquaGid?.Documentation) {
                console.warn('⚠️ Documentation not loaded');
            }
        }
        
        /**
         * Установить режим и показать первый экран
         */
        startBooking(mode) {
            this.currentMode = mode;
            this.resetBooking();
            
            switch(mode) {
                case MODES.QUICK:
                    this.requestLocation();
                    break;
                case MODES.FROM_BOAT:
                    this.showBoatSelection('all');
                    break;
                case MODES.FROM_DATE:
                    this.showDateSelection();
                    break;
            }
        }
        
        /**
         * Запрос геолокации для быстрой ветки
         */
