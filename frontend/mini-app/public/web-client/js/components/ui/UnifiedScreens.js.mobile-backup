            // Для тестов используем мок-координаты (Санкт-Петербург)
            console.log('Используем тестовые координаты (HTTP режим)');
            this.temp.userLocation = {
                lat: 59.9398,
                lon: 30.3146
            };
            this.findNearestBoats();
            
            // Реальный код пока закомментируем
            /*
            if (navigator.geolocation) {
                this.showLoading('Определяем ваше местоположение...');
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        this.temp.userLocation = {
                            lat: position.coords.latitude,
                            lon: position.coords.longitude
                        };
                        this.findNearestBoats();
                    },
                    (error) => {
                        console.error('Ошибка геолокации:', error);
                        this.showBoatSelection('all');
                    }
                );
            } else {
                this.showBoatSelection('all');
            }
            */
        }
        
        /**
         * Поиск ближайших катеров (для QUICK режима)
         */
        async findNearestBoats() {
            if (!this.temp.userLocation) {
                // Если нет геолокации, показываем все катера
                this.showBoatSelection('all');
                return;
            }
            
            // Время уже рассчитано в TimeService
            this.showBoatSelection('quick');
        }
        
        /**
         * Расчет ближайшего доступного времени для катера
         */
        calculateNextAvailableTime(boatId) {
            // TODO: Запрос к API /api/boat/next-available?id=
            // Имитация: текущее время + 20 мин дорога + округление до 30 мин
            const now = new Date();
            now.setMinutes(now.getMinutes() + 20); // дорога
            
            // Округляем до следующих 30 минут
            const minutes = now.getMinutes();
            const roundedMinutes = Math.ceil(minutes / 30) * 30;
            now.setMinutes(roundedMinutes);
            now.setSeconds(0);
            
            return now;
        }
        
        /**
         * Показать экран выбора катера
         */
        async showBoatSelection(type = 'all') {
            console.log('showBoatSelection called with type:', type);
            this.loading = true;
            this.renderLoading();
            
            let boats = [];
            let title = '';
            let subtitle = '';
            
            try {
                if (type === 'quick') {
                    console.log('Loading quick boats with location:', this.temp.userLocation);
                    boats = await this.loadBoats('quick', { 
                        lat: this.temp.userLocation?.lat,
                        lon: this.temp.userLocation?.lon 
                    });
                    console.log('Quick boats loaded:', boats);
                    title = '⚡ Ближайшие катера';
                    subtitle = 'Доступны для прогулки в ближайшее время';
                    
                    // 👇 ВОТ СЮДА - СОХРАНЯЕМ QUICK BOATS
                    this.temp.quickBoats = boats;
                    
                    // Для быстрой ветки добавляем время
                    const slots = AquaGid.TimeService.calculateNearestSlots(new Date());
                    boats = boats.map(boat => ({
                        ...boat,
                        availableFrom: slots.primary,
                        secondarySlot: slots.secondary,
                        hasTimeChoice: slots.hasChoice,
                        diffMinutes: slots.diffMinutes
                    }));
                    
                } else if (type === 'filtered') {
                    boats = await this.loadBoats('filtered', {
                        date: this.booking.date,
                        time: this.booking.time,
                        duration: this.booking.duration
                    });
                    title = '🚤 Доступные катера';
                    subtitle = `На ${this.booking.date ? new Date(this.booking.date).toLocaleDateString() : ''} ${this.booking.time || ''}`;
                    
                    // 👇 И СЮДА - СОХРАНЯЕМ FILTERED BOATS
                    this.temp.availableBoats = boats;
                    
                } else {
                    boats = await this.loadBoats('all');
                    title = '🚤 Выберите катер';
                    subtitle = 'Все доступные катера';
                    
                    // 👇 И СЮДА - СОХРАНЯЕМ ALL BOATS
                    this.temp.availableBoats = boats;
                }
                
                // Формируем HTML
                const html = `
                    <div class="screen boat-selection-screen">
                        <div class="screen__header">
                            <h1>${title}</h1>
                            <p class="screen__subtitle">${subtitle}</p>
                            ${this.renderBookingInfo()}
                        </div>
                        
                        <div class="boats-grid">
                            ${boats.map(boat => this.renderBoatCard(boat, type)).join('')}
                        </div>
                        
                        ${this.renderNavigation()}
                    </div>
                `;
                
                this.render(html);
                this.currentScreen = SCREENS.BOAT_SELECTION;
                
            } catch (error) {
                this.renderError('Ошибка загрузки катеров', error);
            } finally {
                this.loading = false;
            }
        }

        /**
         * Показать загрузку
         */
        renderLoading() {
            const html = `
                <div class="screen loading-screen">
                    <div class="loader"></div>
                    <p>Загрузка катеров...</p>
